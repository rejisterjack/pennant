# Pooled connection string. On Neon, use the host that contains "-pooler".
# The app uses this at runtime.
DATABASE_URL="postgresql://user:password@localhost:5432/pennant"

# Direct connection string for migrations. On Neon, use the host without "-pooler".
# A local Postgres database can use the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/pennant"

# Long random string. Rotating it signs everyone out and invalidates API keys.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
