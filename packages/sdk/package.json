  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rejisterjack/pennant.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/rejisterjack/pennant#readme",
  "bugs": {
    "url": "https://github.com/rejisterjack/pennant/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
