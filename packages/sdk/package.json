{
  "name": "@rejisterjack/pennant",
  "version": "0.1.0",
  "description": "TypeScript client for a self-hosted Pennant feature-flag service.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
